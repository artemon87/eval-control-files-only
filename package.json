{
  "name": "evalhub",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --cache --cache-location .cache/eslint",
    "lint:fix": "eslint . --fix --cache --cache-location .cache/eslint",
    "lint:ci": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint:ci && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "next-auth": "^5.0.0-beta.32",
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "react-server-dom-webpack": "^19.3.0",
    "tailwindcss": "^4.2.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.28"
  },
  "type": "module",
  "displayName": "EvalHub"
}
