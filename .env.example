# FastAPI base URL used by the browser. Include the API version prefix.
NEXT_PUBLIC_EVAL_API_URL=http://localhost:8080/api/v1

# GitHub directory URL for the repository and branch, including /blob/<branch>.
# EvalHub appends the recorded E2E target manifest path.
NEXT_PUBLIC_GITHUB_MANIFEST_BASE_URL=https://github.com/your-org/bryte-agent-skills/blob/main
